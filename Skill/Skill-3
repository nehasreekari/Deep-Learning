import torch
import matplotlib.pyplot as plt
from google.colab import files
from PIL import Image
from transformers import pipeline

# Upload an image from your device
uploaded = files.upload()
image_path = next(iter(uploaded))

# Load an image classification model
classifier = pipeline(
    "image-classification",
    model="google/vit-base-patch16-224"
)

image = Image.open(image_path).convert("RGB")
predictions = classifier(image)

# Display the image and its top predictions
plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.imshow(image)
plt.axis("off")
plt.title("Uploaded image")

plt.subplot(1, 2, 2)
labels = [item["label"] for item in predictions[:5]][::-1]
scores = [item["score"] * 100 for item in predictions[:5]][::-1]

plt.barh(labels, scores, color="#4F46E5")
plt.xlim(0, 100)
plt.xlabel("Confidence (%)")
plt.title("What the model detected")

for i, score in enumerate(scores):
    plt.text(score + 1, i, f"{score:.1f}%", va="center")

plt.tight_layout()
plt.show()
