from pathlib import Path
from collections import Counter
import zipfile
import os
import math
import shutil

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from PIL import Image
import cv2

sns.set_theme(style="whitegrid")

# Upload a ZIP containing your dataset.
# For class distribution, organize images in class-named folders, for example:
# dataset/
#   cats/
#     cat1.jpg
#   dogs/
#     dog1.jpg
#
# Optional YOLO annotations can be inside a labels/ folder as .txt files.
from google.colab import files

uploaded = files.upload()
zip_names = [name for name in uploaded if name.lower().endswith(".zip")]
if not zip_names:
    raise ValueError("Please upload a ZIP file containing the dataset.")

dataset_dir = Path("/content/dataset")
dataset_dir.mkdir(parents=True, exist_ok=True)

with zipfile.ZipFile("/content/" + zip_names[0]) as zf:
    zf.extractall(dataset_dir)

output_dir = Path("/content/audit_output")
output_dir.mkdir(parents=True, exist_ok=True)

image_extensions = {".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff", ".webp"}
images = [
    path for path in dataset_dir.rglob("*")
    if path.is_file() and path.suffix.lower() in image_extensions
    and not any(part.startswith(".") for part in path.relative_to(dataset_dir).parts)
]

if not images:
    raise ValueError("No images found in the uploaded ZIP.")

def get_class_name(image_path):
    relative_path = image_path.relative_to(dataset_dir)
    return relative_path.parts[-2] if len(relative_path.parts) > 1 else "all_images"

# Audit image readability, dimensions, brightness, contrast, and blur.
image_rows = []

for path in images:
    row = {
        "image": str(path),
        "relative_path": str(path.relative_to(dataset_dir)),
        "class": get_class_name(path),
        "readable": False,
        "width": None,
        "height": None,
        "brightness_mean": None,
        "contrast_std": None,
        "blur_score": None,
        "quality_flags": "",
        "file_size_kb": round(path.stat().st_size / 1024, 2),
    }
    flags = []

    try:
        with Image.open(path) as image:
            image.verify()

        image_array = cv2.imread(str(path))
        if image_array is None:
            raise ValueError("Could not decode image")

        height, width = image_array.shape[:2]
        gray = cv2.cvtColor(image_array, cv2.COLOR_BGR2GRAY)

        brightness = float(np.mean(gray))
        contrast = float(np.std(gray))
        blur_score = float(cv2.Laplacian(gray, cv2.CV_64F).var())

        row.update({
            "readable": True,
            "width": width,
            "height": height,
            "brightness_mean": round(brightness, 2),
            "contrast_std": round(contrast, 2),
            "blur_score": round(blur_score, 2),
        })

        if width < 64 or height < 64:
            flags.append("low_resolution")
        if brightness < 25:
            flags.append("very_dark")
        if brightness > 230:
            flags.append("very_bright")
        if blur_score < 50:
            flags.append("possibly_blurry")

    except Exception as error:
        flags.append("unreadable_or_corrupt")
        row["error"] = str(error)[:200]

    row["quality_flags"] = ";".join(flags)
    image_rows.append(row)

image_df = pd.DataFrame(image_rows)
image_df.to_csv(output_dir / "image_quality_audit.csv", index=False)

print(f"Images found: {len(image_df)}")
print(f"Readable: {int(image_df['readable'].sum())}")
print(f"Unreadable: {int((~image_df['readable']).sum())}")

# Class distribution
class_df = (
    image_df["class"]
    .value_counts()
    .rename_axis("class")
    .reset_index(name="image_count")
)
class_df["share_percent"] = (
    class_df["image_count"] / class_df["image_count"].sum() * 100
).round(2)
class_df.to_csv(output_dir / "class_distribution.csv", index=False)

plt.figure(figsize=(max(8, len(class_df) * 0.7), 5))
sns.barplot(data=class_df, x="class", y="image_count", color="#4C78A8")
plt.title("Image Count by Class")
plt.xlabel("Class")
plt.ylabel("Number of images")
plt.xticks(rotation=45, ha="right")
plt.tight_layout()
plt.savefig(output_dir / "class_distribution.png", dpi=160)
plt.show()

display(class_df)

# Image quality charts
readable_df = image_df[image_df["readable"]].copy()

if not readable_df.empty:
    fig, axes = plt.subplots(1, 3, figsize=(16, 4))

    sns.histplot(readable_df["width"], bins=30, ax=axes[0])
    axes[0].set_title("Image Width")

    sns.histplot(readable_df["height"], bins=30, ax=axes[1])
    axes[1].set_title("Image Height")

    sns.histplot(readable_df["blur_score"], bins=30, ax=axes[2])
    axes[2].set_title("Sharpness (Laplacian Variance)")

    plt.tight_layout()
    plt.savefig(output_dir / "image_quality_distributions.png", dpi=160)
    plt.show()

flagged_images = image_df[image_df["quality_flags"] != ""]
print(f"Images with quality flags: {len(flagged_images)}")
display(flagged_images.head(30))

# Optional YOLO annotation validation.
# Expected label rows: class_id x_center y_center width height
# The four coordinates must be normalized between 0 and 1.
labels_dir = dataset_dir / "labels"

if labels_dir.exists():
    image_stems = {image.stem for image in images}
    label_files = list(labels_dir.rglob("*.txt"))
    annotation_rows = []
    class_instances = []
    seen_label_stems = set()

    for label_path in label_files:
        seen_label_stems.add(label_path.stem)
        issues = []
        box_count = 0
        class_ids = []

        try:
            lines = [
                line.strip()
                for line in label_path.read_text(encoding="utf-8").splitlines()
                if line.strip()
            ]

            for line_number, line in enumerate(lines, start=1):
                parts = line.split()

                if len(parts) != 5:
                    issues.append(f"line_{line_number}:expected_5_values")
                    continue

                try:
                    class_id = int(parts[0])
                    x_center, y_center, box_width, box_height = map(float, parts[1:])
                except ValueError:
                    issues.append(f"line_{line_number}:non_numeric_value")
                    continue

                values = [x_center, y_center, box_width, box_height]

                if class_id < 0:
                    issues.append(f"line_{line_number}:negative_class_id")
                if not all(math.isfinite(value) for value in values):
                    issues.append(f"line_{line_number}:non_finite_value")
                if not all(0 <= value <= 1 for value in values):
                    issues.append(f"line_{line_number}:coordinate_out_of_range")
                if box_width <= 0 or box_height <= 0:
                    issues.append(f"line_{line_number}:non_positive_box_size")
                if (
                    x_center - box_width / 2 < 0
                    or y_center - box_height / 2 < 0
                    or x_center + box_width / 2 > 1
                    or y_center + box_height / 2 > 1
                ):
                    issues.append(f"line_{line_number}:box_exceeds_image_bounds")

                class_ids.append(class_id)
                class_instances.append(class_id)
                box_count += 1

            if label_path.stem not in image_stems:
                issues.append("no_matching_image")

        except Exception as error:
            issues.append(f"label_read_error:{str(error)[:100]}")

        annotation_rows.append({
            "label_file": str(label_path),
            "box_count": box_count,
            "class_ids": ",".join(map(str, sorted(set(class_ids)))),
            "status": "invalid" if issues else "valid",
            "issues": ";".join(issues),
        })

    # Report images that do not have a corresponding label file.
    for image in images:
        if image.stem not in seen_label_stems:
            annotation_rows.append({
                "label_file": "",
                "box_count": 0,
                "class_ids": "",
                "status": "missing_label_file",
                "issues": f"no_label_for:{image.relative_to(dataset_dir)}",
            })

    annotation_df = pd.DataFrame(annotation_rows)
    annotation_df.to_csv(output_dir / "annotation_validation.csv", index=False)

    print("Annotation validation results:")
    display(annotation_df[annotation_df["status"] != "valid"].head(50))

    if class_instances:
        yolo_counts = (
            pd.Series(Counter(class_instances))
            .sort_index()
            .rename_axis("class_id")
            .reset_index(name="box_count")
        )
        yolo_counts["class_name"] = yolo_counts["class_id"].map(
            lambda class_id: f"class_{class_id}"
        )
        yolo_counts.to_csv(output_dir / "yolo_box_class_distribution.csv", index=False)

        sns.barplot(data=yolo_counts, x="class_name", y="box_count", color="#E45756")
        plt.title("YOLO Bounding Boxes by Class")
        plt.xticks(rotation=45, ha="right")
        plt.tight_layout()
        plt.savefig(output_dir / "yolo_box_class_distribution.png", dpi=160)
        plt.show()

        display(yolo_counts)
else:
    print("No labels/ folder found. YOLO annotation validation was skipped.")

# Summary report
summary = pd.DataFrame([{
    "total_images": len(image_df),
    "readable_images": int(image_df["readable"].sum()),
    "unreadable_images": int((~image_df["readable"]).sum()),
    "number_of_classes": int(image_df["class"].nunique()),
    "quality_flagged_images": int((image_df["quality_flags"] != "").sum()),
}])
summary.to_csv(output_dir / "audit_summary.csv", index=False)
display(summary)

# Download all reports and charts in one ZIP file.
shutil.make_archive("/content/dataset_audit_reports", "zip", output_dir)
files.download("/content/dataset_audit_reports.zip")
